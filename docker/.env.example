# Image pulled by docker-compose.yml.
OPENVPN_IMAGE=www.durian.fun:32433/openvpn-ui:v0.4

# Client-visible IP or DNS name. No http:// prefix.
OPENVPN_PUBLIC_HOST=vpn.example.com
OPENVPN_PUBLIC_PORT=1194
OPENVPN_PROTOCOL=tcp

# VPN address pool and initial LAN. Both must use IPv4 CIDR notation.
OPENVPN_VPN_CIDR=10.8.0.0/24
OPENVPN_LAN_CIDR=192.168.18.0/24
OPENVPN_NAT_INTERFACE=

# Web administrator. Use a unique password with at least 12 characters.
OPENVPN_ADMIN_USERNAME=admin
OPENVPN_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Bind to 0.0.0.0 for LAN access, or a specific Linux host address.
UI_BIND_IP=0.0.0.0
UI_PORT=8080

# Optional per-login network scopes for the VPN access-control console.
# Example: admin=*;branch-admin=192.168.18.0/24,10.32.22.0/24
# Empty keeps legacy behavior: administrators see all networks.
OPENVPN_UI_NETWORK_SCOPES=
