# Client-visible IP or DNS name. No http:// prefix. REQUIRED before first start.
OPENVPN_PUBLIC_HOST=vpn.example.com
# Host UDP port (forward this port on your router if needed).
OPENVPN_PUBLIC_PORT=1194
# VPN client pool: /24 only; must not overlap LAN, Docker, or client local networks.
OPENVPN_VPN_CIDR=10.8.0.0/24
# Initial LAN example. Manage the final network list in the Web UI.
OPENVPN_LAN_CIDR=192.168.18.0/24
# Optional NAT interface restriction. Empty applies NAT on every routed interface.
OPENVPN_NAT_INTERFACE=

# Web administrator (not VPN client credentials). Set a unique password.
OPENVPN_ADMIN_USERNAME=admin
OPENVPN_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
# Default: access UI through SSH tunnel. Set the Linux LAN IP for direct LAN access.
UI_BIND_IP=127.0.0.1
UI_PORT=8080
