# Client-visible IP or DNS name. No http:// prefix. REQUIRED before first start.
OPENVPN_PUBLIC_HOST=vpn.example.com
# Public OpenVPN port (forward it with the selected TCP/UDP protocol).
OPENVPN_PUBLIC_PORT=1194
# OpenVPN transport: tcp (default) or udp.
OPENVPN_PROTOCOL=tcp
# VPN client pool: /24 only; must not overlap LAN, Docker, or client local networks.
OPENVPN_VPN_CIDR=10.8.0.0/24
# Initial LAN example. Manage the final network list in the Web UI.
OPENVPN_LAN_CIDR=192.168.18.0/24
# Optional NAT interface restriction. Empty applies NAT on every routed interface.
OPENVPN_NAT_INTERFACE=

# Web administrator (not VPN client credentials). Set a unique password.
OPENVPN_ADMIN_USERNAME=admin
OPENVPN_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
# Default: access UI through SSH tunnel. Set the Linux LAN IP for direct LAN access.
UI_BIND_IP=127.0.0.1
UI_PORT=8080

# Per-login network scopes for the VPN access-control console.
# admin can manage all networks; office-admin can manage two selected networks;
# branch-admin can manage only one network. Login matching is case-insensitive.
# Create office-admin and branch-admin in User Profile before using those logins.
# To keep the legacy administrator-only behavior, leave this value empty.
OPENVPN_UI_NETWORK_SCOPES=admin=*;office-admin=192.168.18.0/24,10.32.22.0/24;branch-admin=172.16.10.0/24

# Allow administrators to create, list, edit, and delete Web login profiles.
# false: every login can edit only its own profile (recommended).
ALLOW_USER_MANAGEMENT=false
